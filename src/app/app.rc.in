// Windows resources of HUSTpdf.exe (configured by CMake from app.rc.in; keep this file ASCII,
// rc.exe reads it in the ANSI code page).
//  - GLFW_ICON: GLFW uses an icon with this name for the window and the taskbar; Explorer shows
//    it for the exe (the only icon in the file).
//  - VERSIONINFO: shown in the exe's Properties > Details.

#include <winver.h>

GLFW_ICON ICON "@PROJECT_SOURCE_DIR@/res/HUSTpdf.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "HUSTpdf"
            VALUE "FileDescription",  "HUSTpdf - English-Vietnamese technical PDF reader"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "HUSTpdf"
            VALUE "LegalCopyright",   "AGPL-3.0"
            VALUE "OriginalFilename", "HUSTpdf.exe"
            VALUE "ProductName",      "HUSTpdf"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
